import QtQuick
import Quickshell
import @QML_ROOT@ as Chronicle

ShellRoot {
    id:root
    property int stage:0
    Chronicle.Service {
        id:service
        manifest:({__sourceDir:@REPO_ROOT@})
        demoMode:true
        stateDirectory:@STATE_ROOT@
    }
    Chronicle.HistoryController { id:history; service:service }
    Chronicle.IncidentController { id:editor; service:service }
    Chronicle.InvestigationController { id:tool; service:service }
    Timer {
        interval:50;repeat:true;running:true
        onTriggered:{
            if(service.lastError || editor.error || history.error || tool.error) {console.error("CHRONICLE_INTEGRATION_ERROR "+(service.lastError || editor.error || history.error || tool.error));Qt.quit();return}
            if(root.stage===0 && service.snapshot.session) {service.setPanelOpen("harness",true);root.stage=1}
            else if(root.stage===1 && (service.snapshot.events||[]).length) {history.load({from_us:0,to_us:service.snapshot.time_us,limit:2});root.stage=2}
            else if(root.stage===2 && history.result && history.result.next) {history.older();root.stage=3}
            else if(root.stage===3 && history.pageIndex===1 && !history.busy) {service.request("bookmark",{label:"Before"});root.stage=4}
            else if(root.stage===4 && (service.snapshot.bookmarks||[]).length) {editor.perform("create_incident",{title:"Transport investigation",pin_event_id:service.snapshot.events[0].id});root.stage=5}
            else if(root.stage===5 && editor.item && editor.item.evidence.length && !editor.busy) {editor.edit("Verified committed investigation notes");editor.flush();root.stage=6}
            else if(root.stage===6 && editor.draftSaved && !editor.busy) {editor.save("open");root.stage=7}
            else if(root.stage===7 && !editor.dirty && !editor.busy) {service.request("save_view",{label:"Transport errors",severity:"error",window_minutes:15});root.stage=8}
            else if(root.stage===8 && (service.snapshot.saved_views||[]).length) {service.request("preview_export",{id:editor.item.id,detail:false});root.stage=9}
            else if(root.stage===9 && service.preview) {service.request("confirm_export",{token:service.preview.token});root.stage=10}
            else if(root.stage===10 && service.lastAction.indexOf("Saved reviewed evidence:")===0) {tool.load("context",{id:editor.item.evidence[0].id,scope:"all"});root.stage=11}
            else if(root.stage===11 && tool.result) {
                if(tool.result.anchor.id!==editor.item.evidence[0].id || !tool.result.events.length) {console.error("CHRONICLE_INTEGRATION_ERROR context");Qt.quit();return}
                tool.load("analyze",{from_us:service.snapshot.time_us-300000000,to_us:service.snapshot.time_us,exclude:["not-in-fixture"],sort:"change"});root.stage=12
            }
            else if(root.stage===12 && tool.result) {
                if(tool.result.current_count<45 || !tool.result.groups.length || tool.result.filters.exclude[0]!=="not-in-fixture") {console.error("CHRONICLE_INTEGRATION_ERROR analysis");Qt.quit();return}
                service.request("preview_export",{id:editor.item.id,detail:true,format:"markdown"});root.stage=13
            }
            else if(root.stage===13 && service.preview) {service.request("confirm_export",{token:service.preview.token});root.stage=14}
            else if(root.stage===14 && service.lastAction.indexOf("Saved reviewed evidence:")===0 && !service.preview) {service.shuttingDown=true;service.request("shutdown",{});root.stage=15}
            else if(root.stage===15 && !service.daemonRunning) {console.log("CHRONICLE_INTEGRATION_OK");Qt.quit()}
        }
    }
    Timer { interval:15000;running:true;onTriggered:{console.error("CHRONICLE_INTEGRATION_TIMEOUT stage="+root.stage);Qt.quit()} }
}
